# Multi-Agent Job Application System - Environment Variables

# LLM API Configuration
# Choose ONE provider and set its API key:

# Option 1: Anthropic Claude (Recommended)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Get key at: https://console.anthropic.com/

# Option 2: Google Gemini (Best Value - 10x cheaper than GPT-4)
# GEMINI_API_KEY=your_gemini_api_key_here
# Get key at: https://aistudio.google.com/app/apikey

# Option 3: OpenAI GPT (Alternative)
# OPENAI_API_KEY=your_openai_api_key_here
# Get key at: https://platform.openai.com/api-keys

# Option 4: Ollama (Local/Free)
# No API key needed, just install Ollama: https://ollama.ai/

# Email Configuration
EMAIL_ADDRESS=your.email@gmail.com
EMAIL_PASSWORD=your_app_password_here
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833

# Optional: Cloud Storage
# GOOGLE_DRIVE_CREDENTIALS=/path/to/credentials.json
# DROPBOX_ACCESS_TOKEN=your_dropbox_token

# Optional: Database (for advanced tracking)
# DATABASE_URL=postgresql://user:password@localhost/jobsystem
